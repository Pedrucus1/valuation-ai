#!/bin/sh
# Bloquea commits que contengan secretos hardcodeados.
# Cubre el "Respaldo automatico diario" (git add -A) que ya filtro una key.
# Saltar (bajo tu riesgo): git commit --no-verify

# Patrones de secreto que ya nos han mordido:
#  - Google/Gemini API key:      AIza + 35 chars
#  - Gemini AI Studio (nuevo):   AQ. + 40+ chars
#  - Mongo URI con credenciales: mongodb+srv://user:pass@
#  - OpenAI/DeepSeek key:        sk- + 20+ hex/alfanum
#  - GitHub PAT:                 ghp_ + 36 chars
PATRON='AIza[0-9A-Za-z_-]{35}|AQ\.[A-Za-z0-9_-]{40,}|mongodb(\+srv)?://[^:@/ ]+:[^@/ ]+@|sk-[A-Za-z0-9-]{20,}|ghp_[A-Za-z0-9]{36}'

# Solo revisa el contenido staged de archivos de texto que se agregan/modifican.
hits=$(git diff --cached --no-color -U0 --diff-filter=ACM \
       -- '*.py' '*.js' '*.ts' '*.json' '*.sh' '*.yml' '*.yaml' '*.md' \
       | grep -nE "^\+" | grep -E "$PATRON")

if [ -n "$hits" ]; then
  echo "=============================================================="
  echo " COMMIT BLOQUEADO: se detecto un posible secreto hardcodeado."
  echo "=============================================================="
  echo "$hits" | sed -E 's/(.{100}).*/\1.../'
  echo "--------------------------------------------------------------"
  echo "Muevelo a .env y leelo con os.environ / process.env."
  echo "Si es un falso positivo: git commit --no-verify"
  echo "=============================================================="
  exit 1
fi
exit 0
